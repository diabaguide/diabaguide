# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local env files (Supabase keys, etc.)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Vite / cache
.vite/

# Sorties de tsc émises à côté des sources (le code source est en TypeScript)
src/**/*.js
*.tsbuildinfo

# Vidages mémoire (core dumps) laissés par un processus planté
core
core.*

# Vercel
.vercel
.env*
audit_i18n.json

# Données de recherche et de collecte (privées : le dépôt est public)
/outputs/
/recherche/

# Images de travail déposées dans docs/ (peuvent contenir des données
# personnelles : noms, téléphones de clients)
/docs/*.jpeg
/docs/*.jpg
/docs/*.png

# Réglages Claude Code locaux, sous-agents personnels et skills tiers
# installés localement (réinstallables depuis skills-lock.json)
.claude/settings.local.json
.claude/agents/
.claude/skills/*/
skills-lock.json
