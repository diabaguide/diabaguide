{
  "name": "diaba-guide-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verify-bundle.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:traveler-ui": "node scripts/verify-traveler-ui.mjs",
    "verify:bulk": "node --experimental-strip-types --test scripts/bulk-actions.test.mjs",
    "verify:trash": "node --experimental-strip-types --test scripts/account-trash.test.mjs scripts/fiche-trash.test.mjs",
    "verify:modules": "node --test scripts/module-management.test.mjs",
    "verify:auth": "node --experimental-strip-types --test scripts/simple-auth.test.mjs scripts/auth-pin-api.test.mjs",
    "verify:shipsgo": "node --test scripts/shipsgo-core.test.mjs scripts/shipsgo-api.test.mjs scripts/shipsgo-integrity.test.mjs scripts/verify-shipsgo-ui.mjs",
    "verify:import": "node --test scripts/expedition-import.test.mjs",
    "verify:photos": "node --test scripts/photo-paths.test.mjs scripts/photo-url-batcher.test.mjs",
    "verify:carte": "node --test scripts/barcode.test.mjs scripts/carte-data.test.mjs scripts/position.test.mjs scripts/amap.test.mjs",
    "verify:ux": "node --test scripts/erreurs.test.mjs && node --experimental-strip-types --test scripts/ux-phase1.test.mjs scripts/ux-phase2a.test.mjs scripts/ux-phase2b.test.mjs scripts/ux-phase2c.test.mjs scripts/ux-phase3.test.mjs",
    "verify": "npm run verify:traveler-ui && npm run verify:modules && npm run verify:auth && npm run verify:bulk && npm run verify:trash && npm run verify:shipsgo && npm run verify:import && npm run verify:photos && npm run verify:carte && npm run verify:ux",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/playfair-display": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "libphonenumber-js": "^1.13.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0"
  }
}
